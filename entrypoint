#!/bin/bash

set -euo pipefail
. /.functions

process_template()
{
	local SRC="${1}"

	local TPL="${SRC}"
	[[ "${TPL,,}" =~ [.]tpl ]] || TPL+=".tpl"

	# No template file, so short-circuit
	if ! is_file "${TPL}" ; then
		echo -n "${SRC}"
		return 0
	fi

	require_file_readable "${TPL}"

	# We have a template!! Process it!
	local TGT="${TPL##*/}"
	TGT="$(mktemp --tmpdir="${TEMP_DIR}" "XXXXXXXX.${TGT%.*}" 2>&1)" || return ${?}

	local RC=0
	OUT="$(envsubst < "${TPL}" > "${TGT}" 2>&1)" || RC=${?}
	if [ ${RC} -ne 0 ] ; then
		err "Failed to process the template from [${TPL}]: ${OUT}"
		return ${RC}
	fi

	echo -n "${TGT}"
	return 0
}

# Update the SSL stuff
init_ssl

require_dir_readable "${CONF_DIR}"
require_dir_readwrite "${LOGS_DIR}"
require_dir_readwrite "${TEMP_DIR}"

JAVA_KEYSTORE_PASSWORD="$(<"${SSL_DIR}/keystore.pass")" || fail "Failed to read the SSL keystore password"
JAVA_TRUSTSTORE_PASSWORD="${JAVA_KEYSTORE_PASSWORD}"

set_or_default JAVA_TOOL_OPTIONS ""

# Require SSL for Zookeeper
JAVA_TOOL_OPTIONS+="-XX:MinRAMPercentage=50.0 -XX:MaxRAMPercentage=80.0"

export TEMP="${TEMP_DIR}"
export TMP="${TEMP_DIR}"

set_or_default TIKA_CONFIG "${CONF_DIR}/tika-config.xml"
CONFIG_CANDIDATES=( "${TIKA_CONFIG}" "${CONF_DIR}/server.xml" )

TIKA_CONF=()
for CONFIG in "${CANDIDATES[@]}" ; do
	is_file_readable "${CONFIG}" || continue

	# If this is a template file, expand it!
	FINAL_CONFIG="$(process_template "${CONFIG}" 2>&1)" || fail "Failed to process the template file at [${CONFIG}] (rc=${?}): ${FINAL_CONFIG}"
	say "Using the Tika configuration from [${CONFIG}]"
	[ "${FINAL_CONFIG}" != "${CONFIG}" ] && eyes "\tThe file was a template, and it was processed into [${FINAL_CONFIG}]"

	# Validate the XML!
	OUT="$(xmllint "${FINAL_CONFIG}" 2>&1)" || fail "The resulting template was not valid XML (rc=${?}): ${OUT}"

	# It's good! Use it!
	TIKA_CONF=( --config "${FINAL_CONFIG}" )
	break
done

# Build classpath using wildcards
set_or_default LIB_DIR "${BASE_DIR}/lib"
set_or_default EXTRA_CLASSPATH "${LIB_DIR}/custom/*"
EXTRA_CLASSPATH="$(sanitize_pathspec "${EXTRA_CLASSPATH}")"
CP="${LIB_DIR}/*${EXTRA_CLASSPATH:+:}${EXTRA_CLASSPATH}"

# Build modulepath using wildcards
set_or_default MOD_DIR "${BASE_DIR}/mod"
set_or_default EXTRA_MOD_DIR
EXTRA_MOD_DIR="$(sanitize_pathspec "${EXTRA_MOD_DIR}")"
MP="${MOD_DIR}/*${EXTRA_MOD_DIR:+:}${EXTRA_MOD_DIR}"

set_or_default PORT "8443"
set_or_default EXTRA_ARGS

say "Starting Tika Server"
say "\tClasspath: ${CP}"
say "\tModule Path: ${MP}"
say "\tConfig: ${TIKA_CONF[@]}"
[ -n "${EXTRA_ARGS}" ] && say "\tArgs: [${EXTRA_ARGS}]"
say "\tListening on: *:${PORT}"

to_array EXTRA_ARGS || fail "The extra arguments string [${EXTRA_ARGS}] could not be converted into a BASH array"

set_or_default TIKA_SERVER_CLASS "org.apache.tika.server.core.TikaServerCli"

execute java -cp "/usr/local/bin/tika-server.jar:${CP}" -p "${MP}" "${TIKA_SERVER_CLASS}" "${EXTRA_ARGS[@]}" --port "${PORT}" --host "*" "${TIKA_CONF[@]}"
